{
  "name": "toko-app",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --dir grocery-api start:dev\" \"npm --dir grocery-fe dev\"",
    "dev:grocery-api": "npm --dir grocery-api start:dev",
    "dev:grocery-fe": "npm --dir grocery-fe dev",
    "build": "npm build:grocery-api && npm build:grocery-fe",
    "build:grocery-api": "npm --dir grocery-api build",
    "build:grocery-fe": "npm --dir grocery-fe build",
    "lint": "npm lint:grocery-api && npm lint:grocery-fe",
    "lint:grocery-api": "npm --dir grocery-api lint",
    "lint:grocery-fe": "npm --dir grocery-fe lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}